            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ],
          "body": {
            "type": "json",
            "raw": "{ \"id_movimiento\": 1 }"
          }
        },
        {
          "_id": "req_post_gastos",
          "colId": "col_ahorrapp_gastos",
          "containerId": "",
          "name": "6. POST gastos",
          "sortNum": 6,
          "isDeleted": false,
          "method": "POST",
