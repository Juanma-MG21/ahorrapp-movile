{
  "collections": [
    {
      "_id": "col_ahorrapp_gastos",
      "name": "AhorrApp - Gastos API",
      "containerId": "",
      "requests": [
        {
          "_id": "req_get_categorias",
          "colId": "col_ahorrapp_gastos",
          "containerId": "",
          "name": "1. GET categorias",
          "sortNum": 1,
          "isDeleted": false,
          "method": "GET",
          "url": "{{BASE_URL}}/rest/v1/categorias?select=*&or=(id_usuario.eq.1,es_global.eq.true)&limit=5",
          "headers": [
            { "name": "apikey", "value": "{{ANON_KEY}}" },
            { "name": "Authorization", "value": "Bearer {{ANON_KEY}}" }
          ],
          "body": { "type": "json" }
        },
        {
          "_id": "req_get_dependientes",
          "colId": "col_ahorrapp_gastos",
          "containerId": "",
          "name": "2. GET dependientes",
          "sortNum": 2,
          "isDeleted": false,
          "method": "GET",
          "url": "{{BASE_URL}}/rest/v1/dependientes?select=*&id_usuario=eq.1&limit=5",
          "headers": [
            { "name": "apikey", "value": "{{ANON_KEY}}" },
            { "name": "Authorization", "value": "Bearer {{ANON_KEY}}" }
          ],
          "body": { "type": "json" }
        },
        {
          "_id": "req_get_gastos",
          "colId": "col_ahorrapp_gastos",
          "containerId": "",
          "name": "3. GET gastos",
          "sortNum": 3,
          "isDeleted": false,
          "method": "GET",
          "url": "{{BASE_URL}}/rest/v1/gastos?select=*,categorias(nombre),dependientes(nombre)&order=fecha_registro.desc&limit=5",
          "headers": [
            { "name": "apikey", "value": "{{ANON_KEY}}" },
            { "name": "Authorization", "value": "Bearer {{ANON_KEY}}" }
          ],
          "body": { "type": "json" }
        },
        {
          "_id": "req_post_movimientos",
          "colId": "col_ahorrapp_gastos",
          "containerId": "",
          "name": "4. POST movimientos",
          "sortNum": 4,
          "isDeleted": false,
          "method": "POST",
          "url": "{{BASE_URL}}/rest/v1/movimientos",
          "headers": [
            { "name": "apikey", "value": "{{ANON_KEY}}" },
            { "name": "Authorization", "value": "Bearer {{ANON_KEY}}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ],
          "body": {
            "type": "json",
            "raw": "{ \"id_usuario\": 1, \"tipo_flujo\": \"Salida\", \"subtipo_modulo\": \"Gasto\" }"
          }
        },
        {
